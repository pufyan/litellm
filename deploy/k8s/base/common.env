# Не секретные настройки шлюза, общие для stage и prod (как в compose). Оверлей дописывает свои (`behavior: merge`).
STORE_MODEL_IN_DB=True
LITELLM_MODE=PRODUCTION
LITELLM_LOG=INFO
UI_USERNAME=admin
# Какой конфиг брать: config.yaml — всё через OpenRouter; config-anthropic.yaml — модели Anthropic напрямую
# (нужен ANTHROPIC_API_KEY), при отказе — через OpenRouter. В compose выбор по наличию ключа, здесь — этой строкой.
LITELLM_CONFIG=config.yaml
# Prisma пишет кэш в HOME; корень образа — только на чтение.
HOME=/tmp
